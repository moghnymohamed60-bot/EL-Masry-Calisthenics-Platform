# Database Connection (SQLite for quick start, or PostgreSQL/MySQL connection string for production)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL for Vercel / Railway / Neon:
# DATABASE_URL="postgresql://user:password@host:5432/elmasry_db?schema=public"

# Authentication JWT Secret (Generate with: openssl rand -base64 32)
JWT_SECRET="replace-with-secure-64-char-random-secret"

# Public URL & Default Coach WhatsApp Number
NEXT_PUBLIC_SITE_URL="https://elmasry-calisthenics.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="201099999999"

# Optional Media Storage (Cloudinary / S3-compatible)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional Exchange Rate API Key (falls back to open.er-api.com & cached rates automatically)
EXCHANGE_RATE_API_KEY=""

