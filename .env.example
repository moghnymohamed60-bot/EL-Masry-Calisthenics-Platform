# MySQL Database Connection String (Prisma ORM in backend/prisma/schema.prisma)
DATABASE_URL="mysql://root:password@localhost:3306/elmasry_calisthenics"

# Express Backend Port
PORT=4000

# Authentication JWT Secret
JWT_SECRET="replace-with-secure-64-char-random-secret"

# Public Website URL & Default Coach WhatsApp Number
VITE_SITE_URL="https://elmasry-calisthenics.com"
VITE_WHATSAPP_NUMBER="201099999999"

# Optional Media Storage (Cloudinary / AWS S3)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
S3_BUCKET_NAME=""

# Optional Exchange Rate API Key (falls back to open.er-api.com & cached rates automatically)
EXCHANGE_RATE_API_KEY=""
