{
  "name": "el-masry-calisthenics",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "tsx shared/dev-runner.ts",
    "dev:frontend": "npm run dev --workspace=@el-masry/frontend",
    "dev:backend": "npm run dev --workspace=@el-masry/backend",
    "build": "npm run build --workspace=@el-masry/backend && npm run build --workspace=@el-masry/frontend",
    "test": "npm run test --workspace=@el-masry/shared",
    "lint": "npm run lint --workspace=@el-masry/shared && npm run lint --workspace=@el-masry/backend && npm run lint --workspace=@el-masry/frontend",
    "db:migrate": "npm run db:migrate --workspace=@el-masry/backend",
    "db:seed": "npm run db:seed --workspace=@el-masry/backend"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "framer-motion": "^11.11.17",
    "jose": "^5.9.6",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
